# 이 초안은 키 없이 로컬 데모로 실행됩니다. 아래 값은 모두 비워 두세요.
# 실제 연동을 붙일 때만 채우고, .env 파일은 절대 커밋하지 않습니다.
# 현재 어떤 값도 코드에서 외부로 전송되지 않습니다 (src/adapters 참고).

# 저장소 어댑터: local(기본, 브라우저 localStorage) | supabase(프론트 어댑터 미구현 — 백엔드는 BACKEND.md)
VITE_STORAGE_ADAPTER=local

# Supabase (백엔드 배포됨 · 프론트 연결 전). 공개 가능한 값만: 프로젝트 주소와 publishable(anon) 키
# 서비스 역할 키·비밀 키는 절대 VITE_ 변수나 저장소에 넣지 않습니다 (Edge Function에는 Supabase가 자동 주입)
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=

# 카카오 (미연결 — 로그인·나에게 보내기 알림·카카오맵)
VITE_KAKAO_JS_KEY=
KAKAO_REST_KEY=

# AI 상담 (미연결 — 제공사 미정. 서버 함수에서만 사용해야 함)
LLM_API_KEY=

# 법제처 Open API (미연결 — 법령 변경 감지 전용, 값 자동 변경 안 함)
LAW_API_OC=

# 공공데이터: 특일정보(공휴일), TourAPI(지역 행사) (미연결)
HOLIDAY_API_KEY=
TOUR_API_KEY=

# 예약 실행(하루 1회 알림) 보호용 — 필요 없음. Supabase Vault의 cron_secret을 DB가 직접 씀
# CRON_SECRET=
