# 이 초안은 키 없이 로컬 데모로 실행됩니다. 아래 값은 모두 비워 두세요.
# 실제 연동을 붙일 때만 채우고, .env 파일은 절대 커밋하지 않습니다.
# 기본 local 모드에서는 앱 데이터를 전송하지 않습니다. 연결 플래그/개발 API 계약은 docs/API_HANDOFF.md 참고.

# 저장소 어댑터: local(기본, 브라우저 localStorage) | supabase(미구현)
VITE_STORAGE_ADAPTER=local
# 실제 API/계정 Store와 provider 연결이 완료된 환경에서만 true. 비밀키를 넣지 않습니다.
VITE_AUTH_ENABLED=false
VITE_AI_ENABLED=false

# Supabase (미구현 — 사용자 인증·역할별 RLS·서버 저장용)
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=

# 카카오 (미연결 — 로그인·나에게 보내기 알림·카카오맵)
VITE_KAKAO_JS_KEY=
KAKAO_REST_KEY=

# AI 상담 (미연결 — 제공사 미정. 서버 함수에서만 사용해야 함)
LLM_API_KEY=

# 법제처 Open API (미연결 — 법령 변경 감지 전용, 값 자동 변경 안 함)
LAW_API_OC=

# 공공데이터: 특일정보(공휴일), TourAPI(지역 행사) (미연결)
HOLIDAY_API_KEY=
TOUR_API_KEY=

# 예약 실행(하루 1회 알림 묶음 발송) 보호용 (미구현)
CRON_SECRET=

