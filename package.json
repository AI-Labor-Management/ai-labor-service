{
  "name": "ai-labor-service",
  "private": true,
  "version": "0.1.0",
  "description": "소상공인 사업주용 AI 인사노무 관리 서비스 — 로컬 데모 초안",
  "type": "module",
  "engines": {
    "node": ">=20.19"
  },
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "preview": "vite preview",
