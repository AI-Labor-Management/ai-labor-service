    "test:watch": "vitest",
    "typecheck": "tsc -b --noEmit",
    "build:functions": "node scripts/build-functions.mjs"
  },
  "dependencies": {
    "@supabase/supabase-js": "2.117.3",
    "react": "19.1.1",
    "react-dom": "19.1.1",
    "react-router": "7.18.5"
  },
  "devDependencies": {
    "@anthropic-ai/sdk": "1.3.0",
    "@tailwindcss/vite": "4.1.14",
    "@types/node": "22.18.8",
    "@types/react": "19.1.17",
    "@types/react-dom": "19.1.11",
    "@vitejs/plugin-react": "5.0.4",
    "deno": "2.9.5",
    "esbuild": "0.28.2",
    "jsdom": "27.0.0",
    "tailwindcss": "4.1.14",
    "typescript": "5.9.3",
    "vite": "7.3.7",
    "vitest": "4.1.12"
  }
}
